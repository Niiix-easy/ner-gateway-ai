APP_NAME="Plataforma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# URL pública (HTTPS) para montar postbacks quando APP_URL é local ou HTTP. Instalação Docker: perguntada no install.sh / gravada em .docker/stack.env como PLATFORM_WEBHOOK_PUBLIC_URL.
# PLATFORM_WEBHOOK_PUBLIC_URL=http://platform-gateway.test

# Indica se a aplicação foi instalada (true após wizard ou instalação manual)
APP_INSTALLED=false

# Se true, ao ocorrer erro de tabela/view inexistente (ex.: migration faltando), executa php artisan migrate automaticamente e redireciona
# Recomendado apenas em desenvolvimento/local. Em produção use false.
APP_AUTO_MIGRATE=false

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# MySQL/MariaDB — Docker local (docker-compose.local-db.yml):
#   docker compose -f docker-compose.local-db.yml up -d
# Porta no host: 3307 -> 3306 no container (evita conflito com MySQL do Laragon).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=platform
DB_USERNAME=platform
DB_PASSWORD=platform

# PostgreSQL (opcional — perfil postgres no mesmo compose):
#   docker compose -f docker-compose.local-db.yml --profile postgres up -d
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_DATABASE=platform
# DB_USERNAME=platform
# DB_PASSWORD=platform
# DB_URL=

# Aviso (Postgres + migrate:fresh): parte da cadeia de migrações que converte
# products.id para UUID roda apenas em mysql/mariadb. Prefira MySQL no local.

PLATFORM_DEMO_ADMIN_EMAIL=admin@dev.com
PLATFORM_DEMO_SELLER_EMAIL=info@dev.com

# Ferramenta oculta: /plataforma/ops/mercadopago-saldo (requer platform_admin)
PLATFORM_MP_BALANCE_TOOL_ENABLED=false
# Sessão
SESSION_DRIVER=database
# SESSION_DRIVER=redis
# SESSION_STORE=redis
# Duração em minutos (mínimo 120). 10080 = 7 dias, 43200 = 30 dias
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
# Deixe null para o domínio atual. Para subdomínios compartilhados use .seudominio.com
SESSION_DOMAIN=null
# Cookie Secure: true | false | (vazio = detecta pelo request, use em produção com HTTPS atrás de proxy)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# Proxies confiáveis (load balancer). Em produção informe IPs separados por vírgula; local pode omitir.
# TRUSTED_PROXIES=10.0.0.1

# Instalador web (desabilitar em produção Docker; use install.sh)
# Após instalação em produção, desabilite o instalador web:
# INSTALLER_ENABLED=false
# Durante a instalação, defina um token forte (header X-Installer-Token ou ?installer_token=):
# INSTALLER_TOKEN=gerar-token-forte
# Primeiro admin só via registro público se explicitamente habilitado (prefira: php artisan platform:create-dev-admin)
# CREATE_FIRST_ADMIN=false

# CORS do proxy SDK CajuPay (além de APP_URL)
# CHECKOUT_CORS_ORIGINS=https://checkout.seudominio.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Meta Pixel CAPI — fila dedicada (worker: queue:work --queue=meta-tracking)
META_TRACKING_QUEUE=meta-tracking
META_TRACKING_DEBUG=false

# Utmify — fila dedicada (worker: queue:work --queue=utmify-tracking)
UTMIFY_QUEUE=utmify-tracking
UTMIFY_DEBUG=false

REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — com docker-compose.local-db.yml o serviço expõe 6379 no host por padrão.
# Se mudar LOCALDB_REDIS_PORT no compose, ajuste REDIS_PORT aqui.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379



VITE_APP_NAME="${APP_NAME}"

# CajuPay (PIX): chaves no painel Integrações → Gateways (X-API-Key / X-API-Secret). Opcional:
# CAJUPAY_API_BASE_URL=https://api.cajupay.com.br

# Pagar.me API v5 (opcional): mesma URL para teste/produção; credenciais ficam no painel Integrações → Gateways
# PAGARME_API_BASE_URL=https://api.pagar.me/core/v5

# Assinaturas: dias após o fim do período (current_period_end) em atraso antes de cancelar automaticamente (comando subscriptions:expire-due)
# PLATFORM_SUBSCRIPTION_CANCEL_GRACE_DAYS=14

# Modo demonstração (read-only global). Para desativar: false + php artisan config:clear
# PLATFORM_DEMO_MODE=false
# PLATFORM_DEMO_ADMIN_EMAIL=demo-admin@seudominio.com
# PLATFORM_DEMO_SELLER_EMAIL=demo-vendedor@seudominio.com

# PWA: notificações push do painel (recomendado: configurar em Plataforma → App → Notificações push)
# Legado VAPID via .env (fallback se não houver config no admin):
# PWA_PUSH_PROVIDER=vapid
# PWA_VAPID_PUBLIC=
# PWA_VAPID_PRIVATE=
# Firebase (alternativa; preferir painel admin):
# PWA_PUSH_PROVIDER=fcm
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_WEB_VAPID_KEY=

# ---------------------------------------------------------------------------
# Build white label: sem licença, sem ativação, sem telemetria.
# Não existe portal remoto nem chave a informar — a instalação é 100% sua.
# ---------------------------------------------------------------------------

# Shared hosting: drain database queue via schedule (auto when QUEUE_CONNECTION=database)
# SHARED_HOSTING_QUEUE_DRAIN=true

# ---------------------------------------------------------------------------
# Contato de suporte do operador (o seu) — exibido aos sellers quando definido
# ---------------------------------------------------------------------------
# SUPPORT_WHATSAPP=

